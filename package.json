{
  "name": "slk-core",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "dev:db": "pnpm --filter @slk/db dev:db",
    "db:generate": "pnpm --filter @slk/db db:generate",
    "db:migrate": "pnpm --filter @slk/db db:migrate",
    "db:studio": "pnpm --filter @slk/db db:studio",
    "db:seed": "pnpm --filter @slk/db db:seed",
    "db:demo": "pnpm --filter @slk/db db:demo",
    "theme:vocab": "node scripts/theme-vocab.mjs"
  },
  "devDependencies": {
    "next": "16.3.3",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
